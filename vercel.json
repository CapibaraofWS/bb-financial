{
  "buildCommand": "node build.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/((?!mudanza(?:\\.html)?$).*)",
      "has": [
        {
          "type": "host",
          "value": "bb-financial.vercel.app"
        }
      ],
      "destination": "https://www.bbfinanzas.com.ar/$1",
      "permanent": true
    },
    {
      "source": "/pages/portafolio.html",
      "destination": "/pages/markowitz",
      "permanent": true
    },
    {
      "source": "/pages/portafolio",
      "destination": "/pages/markowitz",
      "permanent": true
    },
    {
      "source": "/pages/cuanto-perdi.html",
      "destination": "/pages/inflacion",
      "permanent": true
    },
    {
      "source": "/pages/cuanto-perdi",
      "destination": "/pages/inflacion",
      "permanent": true
    },
    {
      "source": "/x/inflacion",
      "destination": "/pages/inflacion?utm_source=x&utm_medium=social&utm_campaign=inflacion",
      "permanent": false
    },
    {
      "source": "/x/plazo-fijo",
      "destination": "/pages/comparador-plazos-fijos?utm_source=x&utm_medium=social&utm_campaign=plazo_fijo",
      "permanent": false
    },
    {
      "source": "/x/interes-compuesto",
      "destination": "/pages/interes-compuesto?utm_source=x&utm_medium=social&utm_campaign=interes_compuesto",
      "permanent": false
    },
    {
      "source": "/x/cuotas",
      "destination": "/pages/contado-vs-cuotas?utm_source=x&utm_medium=social&utm_campaign=cuotas",
      "permanent": false
    },
    {
      "source": "/x/sueldo",
      "destination": "/pages/salario?utm_source=x&utm_medium=social&utm_campaign=sueldo",
      "permanent": false
    },
    {
      "source": "/x/fire",
      "destination": "/pages/fire?utm_source=x&utm_medium=social&utm_campaign=fire",
      "permanent": false
    },
    {
      "source": "/x/dolar",
      "destination": "/pages/comparador-dolares?utm_source=x&utm_medium=social&utm_campaign=dolar",
      "permanent": false
    },
    {
      "source": "/x/test",
      "destination": "/pages/test-inversor?utm_source=x&utm_medium=social&utm_campaign=test",
      "permanent": false
    },
    {
      "source": "/x/calculadoras",
      "destination": "/pages/calculadoras?utm_source=x&utm_medium=social&utm_campaign=calculadoras",
      "permanent": false
    },
    {
      "source": "/x/dolar-atrasado",
      "destination": "/pages/blog/tipo-de-cambio-real-dolar-atrasado?utm_source=x&utm_medium=social&utm_campaign=dolar_atrasado",
      "permanent": false
    },
    {
      "source": "/x/inflacion-usa",
      "destination": "/pages/blog/inflacion-estados-unidos-guia-facil?utm_source=x&utm_medium=social&utm_campaign=inflacion_usa",
      "permanent": false
    },
    {
      "source": "/x/atlas",
      "destination": "/pages/atlas?utm_source=x&utm_medium=social&utm_campaign=atlas",
      "permanent": false
    },
    {
      "source": "/x/chips",
      "destination": "/pages/atlas/semiconductores?utm_source=x&utm_medium=social&utm_campaign=chips",
      "permanent": false
    },
    {
      "source": "/x/gnl",
      "destination": "/pages/atlas/gnl?utm_source=x&utm_medium=social&utm_campaign=gnl",
      "permanent": false
    },
    {
      "source": "/x/cuantica",
      "destination": "/pages/atlas/computacion-cuantica?utm_source=x&utm_medium=social&utm_campaign=cuantica",
      "permanent": false
    },
    {
      "source": "/x/tierras-raras",
      "destination": "/pages/atlas/tierras-raras?utm_source=x&utm_medium=social&utm_campaign=tierras_raras",
      "permanent": false
    },
    {
      "source": "/x/:pagina",
      "destination": "/pages/:pagina?utm_source=x&utm_medium=social&utm_campaign=:pagina",
      "permanent": false
    },
    {
      "source": "/x",
      "destination": "/?utm_source=x&utm_medium=social&utm_campaign=inicio",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.jsdelivr.net www.googletagmanager.com www.google-analytics.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' api.worldbank.org open.er-api.com api.alternative.me www.google-analytics.com analytics.google.com region1.google-analytics.com stats.g.doubleclick.net www.googletagmanager.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/pages/(mis-portafolios|portfolio-detalle|watchlist).html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/pages/(mis-portafolios|portfolio-detalle|watchlist)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/mudanza.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/mudanza",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
